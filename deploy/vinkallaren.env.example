# Mall. Produktionsfilen är /etc/vinkallaren.env (root:root, 0600) och skrivs av deploy/install.sh.
# Installern skriver om NODE_ENV, HOST, PORT, PUBLIC_ORIGIN, DB_PATH, COOKIE_SECURE och
# BACKUP_OFFSITE_TARGET, behåller alla andra KEY=value-rader och tar bort kommentarer.
NODE_ENV=production
HOST=127.0.0.1
PORT=3104
PUBLIC_ORIGIN=https://vin.parnes.com
DB_PATH=/var/lib/vinkallaren/vin.db
COOKIE_SECURE=true
BACKUP_OFFSITE_TARGET=

# E-post via SMTP. Lokal postfix: SMTP_HOST=127.0.0.1, SMTP_PORT=25. Port 465: SMTP_SECURE=true.
MAIL_FROM="Vinkällaren <vin@parnes.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

PUBLIC_STATS=true
SESSION_DAYS=30
BACKUP_KEEP=30

CLAUDE_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
