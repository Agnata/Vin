# Kopiera till /etc/vinkallaren.env (chmod 640, ägare root:vinkallaren)
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_PATH=/var/lib/vinkallaren/vin.db
PUBLIC_ORIGIN=https://vin.parnes.com
SESSION_DAYS=30
# Visa antal flaskor, länder och producenter på den publika framsidan.
PUBLIC_STATS=true
BACKUP_KEEP=30

# Claude: avstängt tills vidare. Sätt CLAUDE_ENABLED=true och en API-nyckel för att slå på.
CLAUDE_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# E-post (inbjudningar, glömt lösenord, prenumerationer) via SMTP: ert e-postkonto,
# en tjänst som Postmark, Mailgun eller Amazon SES, eller lokal postfix (SMTP_HOST=localhost, SMTP_PORT=25).
# Lämna SMTP_HOST tomt så skrivs mejlen bara till loggen.
MAIL_FROM="Vinkällaren <vin@parnes.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
