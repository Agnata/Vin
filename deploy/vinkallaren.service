# /etc/systemd/system/vinkallaren.service
[Unit]
Description=Vinkällaren (Node)
After=network.target

[Service]
Type=simple
User=vinkallaren
Group=vinkallaren
WorkingDirectory=/opt/vinkallaren
EnvironmentFile=/etc/vinkallaren.env
ExecStart=/usr/bin/node server/app.js
Restart=on-failure
RestartSec=3

# Härdning: appen får bara skriva i sin datakatalog.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vinkallaren /var/backups/vinkallaren

[Install]
WantedBy=multi-user.target
