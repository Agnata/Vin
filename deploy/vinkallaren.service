# Mall. deploy/install.sh ersätter @…@ och installerar till /etc/systemd/system/vinkallaren.service.
[Unit]
Description=Vinkällaren (@PUBLIC_ORIGIN@)
After=network.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@ENV_FILE@
ExecStart=@NODE_BIN@ --disable-warning=ExperimentalWarning @APP_DIR@/server/app.js
Restart=on-failure
RestartSec=5
StateDirectory=@STATE_DIR_NAME@
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DATA_DIR@

[Install]
WantedBy=multi-user.target
