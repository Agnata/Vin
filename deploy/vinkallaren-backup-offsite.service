# Mall. deploy/install.sh ersätter @…@ och installerar till /etc/systemd/system/.
[Unit]
Description=Vinkällaren: kopiera backuper till extern plats
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
EnvironmentFile=@ENV_FILE@
ExecStart=@APP_DIR@/deploy/vinkallaren-backup-offsite.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@OFFSITE_RW_PATHS@
